{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/aidantay/nf-isoseq2msdb/master/assets/schema_variantcalling_input.json",
    "title": "aidantay/nf-isoseq2msdb pipeline - params.variantcalling_input schema",
    "description": "Schema for the file provided with params.variantcalling_input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "variantcaller": {
                "type": "string",
                "enum": ["Clair3", "DeepVariant"],
                "errorMessage": "Variant caller must be 'Clair3' or 'DeepVariant'"
            },
            "vcf": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.vcf\\.gz$",
                "errorMessage": "VCF file must be a .vcf.gz file and cannot contain spaces"
            },
            "tbi": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.tbi$",
                "errorMessage": "TBI index file must be a .tbi file and cannot contain spaces"
            }
        },
        "required": ["sample", "variantcaller", "vcf", "tbi"]
    }
}
